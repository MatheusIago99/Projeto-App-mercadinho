# Copie este arquivo para ".env" (ou defina as variáveis no seu provedor de
# hospedagem) e preencha os valores. Nunca commite o ".env" real.

# Segredo usado para assinar o cookie de sessão. Use uma string longa e
# aleatória em produção (ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=

# Credenciais do administrador inicial. Usadas SOMENTE no primeiro boot,
# quando ainda não existe nenhum usuário no banco — depois disso, alterar
# essas variáveis não tem efeito (o usuário já existe e não é recriado
# nem sobrescrito automaticamente).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# "production" ativa o cookie de sessão "Secure" (exige HTTPS).
NODE_ENV=development
